# Condor en Hostinger shared hosting (LiteSpeed)
# public_html contiene el repositorio completo. Solo /public es superficie web.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Evita bucles para reescrituras internas ya resueltas dentro de /public.
    RewriteRule ^public(?:/|$) - [L]

    # Entrypoints mínimos permitidos en la raíz del deploy.
    RewriteRule ^(?:index\.php|runtime-check\.php)$ - [L]

    # Sirve únicamente archivos públicos reales desde /public.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Cualquier otra ruta entra por el front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
