# Condor en Hostinger shared hosting
#
# Hostinger usa public_html como document root. Symfony mantiene su superficie
# pública en /public, así que toda petición debe entrar por ese directorio.
# La reescritura es interna: las URLs públicas no muestran /public.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Evita bucles después de la reescritura interna hacia /public.
    RewriteRule ^public(?:/|$) - [L]

    # Todo el tráfico web se resuelve exclusivamente dentro de /public.
    # Esto evita servir config/, src/, vendor/, composer.json, etc.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallar cerrado si mod_rewrite no estuviera disponible.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
