APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-local-only
DATABASE_URL="mysql://condor:condor@127.0.0.1:3306/condor?charset=utf8mb4"
RELEASE_SHA=dev

# Origen server-side usado para enlaces sensibles; nunca se deriva del request.
CONDOR_CANONICAL_URL="https://www.condorapp.com.co"

# ControlBot /ops: desactivado hasta configurar clave fuerte y allowlist.
CONDOR_CONTROLBOT_KEY_ID=""
CONDOR_CONTROLBOT_KEY=""
CONDOR_CONTROLBOT_ALLOWED_IPS=""

# Correo transaccional: Resend elegido, SIN activar. Configurar por /adminpl0n3r al integrar #1726-#1728.
# Respaldo temporal solo en entorno protegido, nunca con credenciales en Git.
# DSN de formato ilustrativo (NO usar como valor activo): smtps://resend:CLAVE_DE_PRUEBA@smtp.resend.com:465
# CONDOR_MAIL_PROVIDER=resend; remitente de dominio verificado, configurado fuera de Git.
CONDOR_MAILER_DSN=""
CONDOR_MAIL_FROM=""
CONDOR_MAIL_PROVIDER=""

# Integraciones del propietario: OFF por defecto. Solo el dueño puede establecer
# true en el entorno del servidor para guardar secretos cifrados en construcción o live.
# No activa envío de correos, proveedores ni uso de las claves por sí solo.
CONDOR_PLATFORM_INTEGRATIONS_SECRET_WRITE_ENABLED=""
# Segunda autorización independiente para envío real de correo de prueba; OFF.
CONDOR_PLATFORM_TEST_EMAIL_ENABLED=""
# Test event only; explicit owner opt-in and secret-write gate. Default off.
CONDOR_PLATFORM_SENTRY_TEST_ENABLED=""

# Módulos desarrollados: habilitados por defecto (#1940).
# Freno de emergencia por módulo: establecer FLAG=false en el entorno del servidor.
# Autorización por rol, tenant y CSRF permanece obligatoria.
HR_REAL_DATA_ENABLED=true
PAYROLL_REAL_DATA_ENABLED=true
CONTRACTS_REAL_DATA_ENABLED=true
SOCIAL_SECURITY_REAL_DATA_ENABLED=true
FINANCE_REAL_DATA_ENABLED=true
OHS_REAL_DATA_ENABLED=true
LEGAL_COMPLIANCE_REAL_DATA_ENABLED=true
GOVERNANCE_REAL_DATA_ENABLED=true
OPERATIONS_PROCESSES_REAL_DATA_ENABLED=true
CUSTOMER_SERVICE_REAL_DATA_ENABLED=true
ASSETS_REAL_DATA_ENABLED=true

# Wompi: transacciones sintéticas únicamente en sandbox; falso = no HTTP.
CONDOR_PAYMENTS_SANDBOX_ENABLED="false"
# Solo rutas a archivos 0600 de claves de PRUEBA; no escribir secretos en .env.
WOMPI_PUBLIC_KEY_FILE=""
WOMPI_PRIVATE_KEY_FILE=""
WOMPI_INTEGRITY_SECRET_FILE=""
WOMPI_EVENTS_SECRET_FILE=""
