{% extends 'base.html.twig' %}

{% block title %}Cambiar contraseña · Condor App{% endblock %}
{% block head %}<meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<section class="auth-layout">
    <div class="auth-card">
        <span class="eyebrow">Seguridad</span>
        <h1>Cambiar contraseña</h1>
        <p class="muted">Usa al menos 12 caracteres y una contraseña distinta de la actual.</p>

        {% for message in app.flashes('success') %}<output class="alert">{{ message }}</output>{% endfor %}
        {% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

        <form method="post" class="stack">
            <label>
                <span>Contraseña actual</span>
                <input type="password" name="current_password" autocomplete="current-password" required>
            </label>
            <label>
                <span>Nueva contraseña</span>
                <input type="password" name="new_password" autocomplete="new-password" minlength="12" required>
            </label>
            <label>
                <span>Confirmar contraseña</span>
                <input type="password" name="password_confirmation" autocomplete="new-password" minlength="12" required>
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_change') }}">
            <button class="button" type="submit">Actualizar contraseña</button>
        </form>

        <p class="version-line">V {{ app_version }}</p>
    </div>
</section>
{% endblock %}
