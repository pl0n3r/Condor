{% extends 'base.html.twig' %}

{% block title %}Recuperar contraseña · Condor App{% endblock %}
{% block head %}<meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<section class="auth-layout">
    <div class="auth-card">
        <span class="eyebrow">Seguridad</span>
        <h1>Recuperar contraseña</h1>
        <p class="muted">Escribe el correo de tu cuenta. La respuesta será la misma exista o no la cuenta.</p>

        {% if message %}<output class="alert">{{ message }}</output>{% endif %}

        <form method="post" class="stack">
            <label>
                <span>Correo</span>
                <input type="email" name="email" autocomplete="email" required>
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_request') }}">
            {% if captcha_sitekey %}
                <div class="cf-turnstile" data-sitekey="{{ captcha_sitekey }}" data-action="condor_password_reset"></div>
            {% elseif captcha_required %}
                <p role="alert">La verificación de seguridad no está disponible. Intenta más tarde.</p>
            {% endif %}
            <button class="button" type="submit"{% if captcha_required and not captcha_sitekey %} disabled{% endif %}>Enviar instrucciones</button>
        </form>
        {% if captcha_sitekey %}
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        {% endif %}

        <p><a href="{{ path('app_login') }}">Volver al ingreso</a></p>
        <p class="version-line">V {{ app_version }}</p>
    </div>
</section>
{% endblock %}
