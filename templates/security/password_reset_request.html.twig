{% extends 'base.html.twig' %}

{% block title %}Recuperar contraseña · Condor App{% endblock %}
{% block head %}<meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<section class="auth-layout">
    <div class="auth-card">
        <span class="eyebrow">Seguridad</span>
        <h1>Recuperar contraseña</h1>
        <p class="muted">Escribe el correo de tu cuenta. La respuesta será la misma exista o no la cuenta.</p>

        {% if message %}<output class="alert">{{ message }}</output>{% endif %}
        {% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

        <form method="post" class="stack">
            <label>
                <span>Correo</span>
                <input type="email" name="email" autocomplete="email" required>
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_request') }}">
            <button class="button" type="submit">Enviar instrucciones</button>
        </form>

        <p><a href="{{ path('app_login') }}">Volver al ingreso</a></p>
        <p class="version-line">V {{ app_version }}</p>
    </div>
</section>
{% endblock %}
