{% extends 'base.html.twig' %}

{% block title %}Restablecer contraseña · Condor App{% endblock %}
{% block head %}<meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<section class="auth-layout">
    <div class="auth-card">
        <span class="eyebrow">Seguridad</span>
        <h1>Restablecer contraseña</h1>
        <p class="muted">El enlace es de un solo uso y vence en 60 minutos.</p>

        {% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

        <form method="post" class="stack" id="password-reset-form">
            <input type="hidden" name="token" id="password-reset-token" value="">
            <label>
                <span>Nueva contraseña</span>
                <input type="password" name="password" autocomplete="new-password" minlength="12" required>
            </label>
            <label>
                <span>Confirmar contraseña</span>
                <input type="password" name="password_confirmation" autocomplete="new-password" minlength="12" required>
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_complete') }}">
            <button class="button" type="submit" id="password-reset-submit" disabled>Actualizar contraseña</button>
        </form>

        <p><a href="{{ path('app_password_reset_request') }}">Solicitar un enlace nuevo</a></p>
        <p class="version-line">V {{ app_version }}</p>
    </div>
</section>
<script>
(() => {
    const fragment = new URLSearchParams(window.location.hash.slice(1));
    const token = fragment.get('token') || '';
    const valid = /^[a-f0-9]{64}$/i.test(token);
    document.getElementById('password-reset-token').value = valid ? token.toLowerCase() : '';
    document.getElementById('password-reset-submit').disabled = !valid;
    history.replaceState(null, '', window.location.pathname + window.location.search);
})();
</script>
{% endblock %}
