{% extends 'base.html.twig' %}

{% block title %}Administrar sitio · {{ storefront.name }} · Condor App{% endblock %}

{% block head %}
<meta name="robots" content="noindex,nofollow">
{% endblock %}

{% block body %}
<div class="storefront-admin">
    <header class="storefront-admin-nav">
        <a class="wordmark" href="{{ path('app_admin') }}">Condor App</a>
        <a href="{{ path('app_admin') }}">Volver al administrador</a>
    </header>

    <div class="storefront-admin-heading">
        <span class="eyebrow">Sitio y e-commerce · Empresa activa</span>
        <h1>Identidad y canal público</h1>
        <p>Configura la presentación pública y el origen comercial de <strong>{{ storefront.name }}</strong>.
           DNS, TLS y despliegue siguen siendo operaciones separadas.</p>
    </div>

    {% if saved %}
        <output class="storefront-admin-notice">
            {{ saved == 'channel' ? 'La configuración del canal fue guardada.' : 'Los cambios del sitio fueron guardados.' }}
        </output>
    {% endif %}
    {% for error in errors %}
        <p class="alert alert-error" role="alert">{{ error }}</p>
    {% endfor %}

    <div class="storefront-admin-grid">
        <section class="storefront-admin-card" aria-labelledby="profile-heading">
            <span class="eyebrow">Contenido público</span>
            <h2 id="profile-heading">Perfil del negocio</h2>
            {% if can_edit %}
                <form method="post" action="{{ path('app_storefront_admin') }}" class="storefront-admin-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('storefront_profile') }}">
                    <input type="hidden" name="_action" value="profile">
                    <label for="storefront-headline">Titular</label>
                    <input id="storefront-headline" name="headline" maxlength="120"
                           value="{{ storefront.headline }}" placeholder="Titular opcional">
                    <label for="storefront-description">Descripción</label>
                    <textarea id="storefront-description" name="description"
                              maxlength="500" rows="6"
                              placeholder="Describe tu empresa">{{ storefront.description }}</textarea>
                    <button class="button" type="submit">Guardar identidad pública</button>
                </form>
            {% else %}
                <p>Tu permiso permite consultar esta identidad, pero no modificarla.</p>
                {% if storefront.headline %}<h3>{{ storefront.headline }}</h3>{% endif %}
                {% if storefront.description %}<p>{{ storefront.description }}</p>{% endif %}
            {% endif %}
        </section>

        <section class="storefront-admin-card" aria-labelledby="channel-heading">
            <span class="eyebrow">Canal comercial</span>
            <h2 id="channel-heading">E-commerce</h2>
            {% if channel %}
                <p>
                    Estado:
                    <strong>{{ channel.publishable ? 'Publicable' : 'No publicable' }}</strong>
                    · Razón social: {{ channel.legal_entity }}
                </p>
            {% else %}
                <p>Aún no hay un canal e-commerce configurado.</p>
            {% endif %}

            {% if can_edit %}
                {% if channel_sources and price_lists %}
                    <form method="post" action="{{ path('app_storefront_admin') }}"
                          class="storefront-admin-form channel-admin-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('storefront_channel') }}">
                        <input type="hidden" name="_action" value="channel">

                        <label for="channel-name">Nombre del canal</label>
                        <input id="channel-name" name="name" maxlength="160"
                               value="{{ channel ? channel.name : 'Tienda web' }}" required>

                        <label for="channel-slug">Identificador</label>
                        <input id="channel-slug" name="slug" maxlength="120"
                               value="{{ channel ? channel.slug : 'tienda-web' }}" required>

                        {% if channel_sources|length == 1 %}
                            <input type="hidden" name="inventory_source_id" value="{{ channel_sources[0].id }}">
                            <p class="muted" data-single-channel-source>
                                Fuente de inventario: <strong>{{ channel_sources[0].name }}</strong>
                                · {{ channel_sources[0].legal_entity }}
                            </p>
                        {% else %}
                            <label for="channel-source">Fuente de inventario</label>
                            <select id="channel-source" name="inventory_source_id" required>
                                {% for source in channel_sources %}
                                    <option value="{{ source.id }}"
                                        {% if channel and channel.inventory_source_id == source.id %}selected{% endif %}>
                                        {{ source.name }} · {{ source.legal_entity }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}

                        {% if price_lists|length == 1 %}
                            <input type="hidden" name="price_list_id" value="{{ price_lists[0].id }}">
                            <p class="muted" data-single-price-list>
                                Lista de precios: <strong>{{ price_lists[0].name }}</strong>
                                · {{ price_lists[0].currency }}
                            </p>
                        {% else %}
                            <label for="channel-price-list">Lista de precios</label>
                            <select id="channel-price-list" name="price_list_id" required>
                                {% for list in price_lists %}
                                    <option value="{{ list.id }}"
                                        {% if channel and channel.price_list_id == list.id %}selected{% endif %}>
                                        {{ list.name }} · {{ list.currency }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}

                        <label>
                            <input type="checkbox" name="active" value="1"
                                {% if channel is null or channel.active %}checked{% endif %}>
                            Canal activo
                        </label>

                        <button class="button" type="submit">
                            {{ channel ? 'Guardar canal' : 'Crear canal e-commerce' }}
                        </button>
                    </form>
                {% else %}
                    <p class="muted">
                        Necesitas al menos una fuente de inventario autorizada y una lista de precios activa.
                    </p>
                {% endif %}
            {% else %}
                <p>Tu permiso permite consultar el canal, pero no modificarlo.</p>
            {% endif %}
        </section>

        <section class="storefront-admin-card" aria-labelledby="domains-heading">
            <span class="eyebrow">Conexión y visibilidad</span>
            <h2 id="domains-heading">Dominios registrados</h2>
            <p>El estado muestra registros internos de Condor. La comprobación real de
               DNS, HTTPS y Hostinger es una operación separada.</p>
            <dl class="storefront-domain-list">
                <div>
                    <dt>Dirección de Condor</dt>
                    <dd><a href="{{ storefront.canonical }}">{{ storefront.canonical }}</a></dd>
                </div>
                {% for domain in domains %}
                    <div>
                        <dt>{{ domain.host }}</dt>
                        <dd>{{ domain.status }}{% if domain.primary %} · Primario registrado{% endif %}</dd>
                    </div>
                {% else %}
                    <div>
                        <dt>Sin dominio personalizado registrado</dt>
                        <dd>El sitio funciona mediante su slug bajo Condor.</dd>
                    </div>
                {% endfor %}
            </dl>
        </section>
    </div>
</div>
{% endblock %}
