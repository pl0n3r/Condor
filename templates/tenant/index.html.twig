{% extends 'base.html.twig' %}

{% block title %}{{ storefront.name }} · Condor App{% endblock %}

{% block head %}
<link rel="canonical" href="{{ storefront.canonical }}">
{% if storefront.description %}
<meta name="description" content="{{ storefront.description }}">
{% endif %}
{% endblock %}

{% block body %}
<section class="hero storefront-hero">
    <span class="eyebrow">Sitio de empresa</span>
    <h1>{{ storefront.headline ?: storefront.name }}</h1>
    {% if storefront.description %}
        <p>{{ storefront.description }}</p>
    {% else %}
        <p>{{ storefront.name }} ya tiene una presencia pública real administrada desde Condor.</p>
    {% endif %}
</section>
{% endblock %}
