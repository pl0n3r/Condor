{% extends 'base.html.twig' %}

{% block title %}{{ storefront.name }} · Condor App{% endblock %}

{% block head %}
<link rel="canonical" href="{{ storefront.canonical }}">
{% if storefront.description %}
<meta name="description" content="{{ storefront.description }}">
{% endif %}
{% endblock %}

{% block body %}
<section class="hero storefront-hero" data-tenant-slug="{{ storefront.slug }}">
    <span class="eyebrow">Sitio de empresa</span>
    <h1>{{ storefront.headline ?: storefront.name }}</h1>
    {% if storefront.description %}
        <p>{{ storefront.description }}</p>
    {% else %}
        <p>{{ storefront.name }} ya tiene una presencia pública real administrada desde Condor.</p>
    {% endif %}
</section>

{% if catalog.channel %}
<section class="storefront-catalog" aria-labelledby="catalog-heading">
    <span class="eyebrow">Catálogo</span>
    <h2 id="catalog-heading">{{ catalog.channel.name }}</h2>

    {% for product in catalog.products %}
        <article class="storefront-product" data-product-slug="{{ product.slug }}">
            <h3>{{ product.name }}</h3>
            {% if product.description %}<p>{{ product.description }}</p>{% endif %}

            <div class="storefront-variants">
                {% for variant in product.variants %}
                    <div class="storefront-variant" data-sku="{{ variant.sku }}">
                        <strong>{{ variant.name }}</strong>
                        <span>
                            COP {{ (variant.price.effective_amount_minor / 100)|number_format(2, ',', '.') }}
                        </span>
                        <span>
                            {{ variant.availability == 'available' ? 'Disponible' : 'Agotado' }}
                            {% if variant.backorder %} · bajo pedido{% endif %}
                        </span>
                    </div>
                {% endfor %}
            </div>
        </article>
    {% else %}
        <p class="muted">El catálogo todavía no tiene productos publicables.</p>
    {% endfor %}
</section>
{% endif %}
{% endblock %}
