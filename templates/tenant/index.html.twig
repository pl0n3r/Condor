{% extends 'base.html.twig' %}

{% block title %}{{ storefront.name }} · Condor App{% endblock %}

{% block head %}
<link rel="canonical" href="{{ storefront.canonical }}">
{% if storefront.description %}
<meta name="description" content="{{ storefront.description }}">
{% endif %}
{% endblock %}

{% block body %}
<section class="hero storefront-hero" data-tenant-slug="{{ storefront.slug }}">
    <span class="eyebrow">Sitio de empresa</span>
    <h1>{{ storefront.headline ?: storefront.name }}</h1>
    {% if storefront.description %}
        <p>{{ storefront.description }}</p>
    {% else %}
        <p>{{ storefront.name }} ya tiene una presencia pública real administrada desde Condor.</p>
    {% endif %}
</section>

{% if catalog.channel %}
<section class="storefront-catalog" aria-labelledby="catalog-heading">
    <span class="eyebrow">Catálogo</span>
    <h2 id="catalog-heading">{{ catalog.channel.name }}</h2>

    <form method="get" class="storefront-catalog-filters" role="search">
        <label for="catalog-q">Buscar productos</label>
        <input id="catalog-q" type="search" name="q" maxlength="80"
               value="{{ catalog.filters.q }}" placeholder="Nombre o descripción">
        <label for="catalog-category">Categoría</label>
        <select id="catalog-category" name="categoria">
            <option value="">Todas las categorías</option>
            {% for category in catalog.categories %}
                <option value="{{ category.slug }}" {% if category.slug == catalog.filters.categoria %}selected{% endif %}>{{ category.name }}</option>
            {% endfor %}
        </select>
        <button type="submit">Buscar</button>
    </form>

    {% for product in catalog.products %}
        <article class="storefront-product" data-product-slug="{{ product.slug }}">
            <h3>{{ product.name }}</h3>
            {% if product.primary_image %}
                <img class="storefront-product-cover"
                     src="{{ product.primary_image.url }}"
                     alt="{{ product.name }}"
                     loading="lazy" decoding="async">
            {% endif %}
            {% if product.description %}<p>{{ product.description }}</p>{% endif %}

            <div class="storefront-variants">
                {% for variant in product.variants %}
                    <div class="storefront-variant" data-sku="{{ variant.sku }}">
                        <strong>{{ variant.name }}</strong>
                        <span>
                            COP {{ (variant.price.effective_amount_minor / 100)|number_format(2, ',', '.') }}
                        </span>
                        <span>
                            {{ variant.availability == 'available' ? 'Disponible' : 'Agotado' }}
                            {% if variant.backorder %} · bajo pedido{% endif %}
                        </span>
                    </div>
                {% endfor %}
            </div>
        </article>
    {% else %}
        <p class="muted">El catálogo todavía no tiene productos publicables.</p>
    {% endfor %}

    {% if catalog.pagination.has_previous or catalog.pagination.has_next %}
        <nav class="storefront-pagination" aria-label="Paginación del catálogo">
            {% if catalog.pagination.has_previous %}
                <a href="{{ catalog.pagination.previous_href }}">Anterior</a>
            {% endif %}
            <span>Página {{ catalog.pagination.page }}</span>
            {% if catalog.pagination.has_next %}
                <a href="{{ catalog.pagination.next_href }}">Siguiente</a>
            {% endif %}
        </nav>
    {% endif %}
</section>
{% endif %}
{% endblock %}
