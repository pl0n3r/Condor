{% extends 'base.html.twig' %}

{% block title %}Configura tu Cóndor{% endblock %}

{% block head %}
<link rel="stylesheet" href="/marketing.css">
<link rel="stylesheet" href="/configurator.css">
{% endblock %}

{% block body %}
<div class="mk-site">
{% include 'marketing/_nav.html.twig' with {'current': 'configurar'} %}
<div class="mk-wrap">
<section class="configurator-page" aria-labelledby="configurator-title">
    <div class="mk-top configurator-top">
        <div><span class="mk-eyebrow eyebrow">Configura tu Cóndor</span><h1 id="configurator-title">Encuentra una configuración que se adapte a tu operación.</h1></div>
        <p class="mk-lead muted">Elige plan, operación y escala. El precio se recalcula siempre con el catálogo vigente del servidor.</p>
    </div>
    <div id="condor-configurator-root" data-version="{{ app_version }}">
        <output>Cargando configurador…</output>
    </div>
</section>
</div>
</div>
<script src="/configurator-telemetry.js"></script>
<script type="module" src="/build/configurator.js?v={{ app_version|url_encode }}"></script>
{% endblock %}
