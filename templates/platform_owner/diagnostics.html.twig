{% extends 'base.html.twig' %}

{% block title %}Diagnósticos · Condor App{% endblock %}

{% block head %}
<meta name="robots" content="noindex,nofollow">
<link rel="stylesheet" href="/build/admin.css">
{% endblock %}

{% block body %}
<section class="admin-shell" aria-label="Diagnósticos de Condor">
    <aside class="sidebar">
        <strong>Condor App</strong>
        <nav aria-label="Navegación propietaria">
            <a href="{{ path('app_platform_owner') }}">Plataforma</a>
            <a href="{{ path('app_platform_diagnostics') }}" aria-current="page">Diagnósticos</a>
        </nav>
        <form method="post" action="{{ path('app_logout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button class="button button-secondary" type="submit">Cerrar sesión</button>
        </form>
    </aside>

    <div class="workspace">
        <span class="eyebrow">Propietario · observabilidad</span>
        <h1>Diagnósticos seguros</h1>
        <p class="muted">Los enlaces compartidos duran 30 minutos, son de solo lectura y nunca incluyen headers, cookies, request bodies ni secretos.</p>

        <div class="foundation-grid">
            {% for incident in incidents %}
                <article>
                    <strong>{{ incident.id }}</strong>
                    <span>{{ incident.occurredAt|date('Y-m-d H:i:s', 'UTC') }} UTC · HTTP {{ incident.status }} · {{ incident.routeName ?? '(sin ruta)' }}</span>
                    <span><strong>Excepción:</strong> {{ incident.exceptionClass }}</span>
                    <span><strong>Mensaje sanitizado:</strong> {{ incident.message }}</span>
                    <span><strong>Request ID:</strong> {{ incident.requestId }}</span>
                    <span><strong>Release:</strong> V {{ incident.version }} · {{ incident.releaseSha }}</span>
                    <span>Fingerprint: {{ incident.fingerprint|slice(0, 16) }}…</span>
                    <form method="post" action="{{ path('app_platform_diagnostic_share_create', {id: incident.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('diagnostic_share_' ~ incident.id) }}">
                        <button class="button" type="submit">Crear enlace temporal</button>
                    </form>
                </article>
            {% else %}
                <article><strong>Sin errores registrados</strong><span>Los próximos 5xx internos aparecerán aquí con una referencia segura.</span></article>
            {% endfor %}
        </div>

        {% if shares %}
            <h2>Enlaces activos</h2>
            <div class="foundation-grid">
                {% for share in shares %}
                    <article>
                        <strong>{{ share.id }}</strong>
                        <span>Error {{ share.incident.id }} · vence {{ share.expiresAt|date('Y-m-d H:i:s', 'UTC') }} UTC</span>
                        <form method="post" action="{{ path('app_platform_diagnostic_share_revoke', {id: share.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('diagnostic_revoke_' ~ share.id) }}">
                            <button class="button button-secondary" type="submit">Revocar</button>
                        </form>
                    </article>
                {% endfor %}
            </div>
        {% endif %}

        <h2>Rendimiento reciente</h2>
        <p class="muted">
            Duración y memoria pico de las últimas {{ request_metrics.count }}
            requests conservadas en <code>var/log/request_metrics.log</code>.
            El archivo agrega solicitudes de los procesos que comparten este
            despliegue y persiste entre recargas de PHP-FPM mientras exista;
            no sustituye una plataforma de métricas agregadas.
        </p>
        {% if request_metrics.count > 0 %}
            <div class="foundation-grid">
                <article>
                    <strong>p50</strong>
                    <span>{{ request_metrics.p50_ms }} ms</span>
                </article>
                <article>
                    <strong>p95</strong>
                    <span>{{ request_metrics.p95_ms }} ms</span>
                </article>
                <article>
                    <strong>Tasa de error 5xx</strong>
                    <span>{{ request_metrics.error_rate }}%</span>
                </article>
                <article>
                    <strong>Memoria pico promedio</strong>
                    <span>{{ request_metrics.avg_memory_mb }} MB</span>
                </article>
            </div>
        {% else %}
            <div class="foundation-grid">
                <article>
                    <strong>Sin solicitudes medidas</strong>
                    <span>Las métricas aparecerán aquí después de registrar requests.</span>
                </article>
            </div>
        {% endif %}

        <h2>Reporte de actividad funcional</h2>
        <p class="muted">
            Serie diaria (30 días) de señales funcionales agregadas, sin PII.
        </p>
        <a class="button button-secondary" href="{{ path('app_platform_activity_report_csv') }}">
            Descargar CSV
        </a>

        <h2>Registro de fallos fatales</h2>
        <p class="muted">
            Funciona incluso si Symfony no llega a arrancar (contenedor
            desincronizado, error de configuración): no depende de Twig ni
            de la base de datos. El enlace es de solo lectura; se revoca
            rotando <code>APP_SECRET</code>.
        </p>
        <div class="foundation-grid">
            <article>
                <strong>Visor independiente</strong>
                <span><code>{{ fatal_log_url }}</code></span>
            </article>
        </div>

        <p class="version-line">V {{ app_version }}</p>
    </div>
</section>
{% endblock %}
