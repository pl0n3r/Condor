{% extends 'base.html.twig' %}

{% block title %}Propietario · Condor App{% endblock %}

{% block head %}
<meta name="robots" content="noindex,nofollow">
<link rel="stylesheet" href="/build/admin.css">
{% endblock %}

{% block body %}
<div
    id="condor-platform-root"
    data-version="{{ app_version }}"
    data-logout-token="{{ csrf_token('logout') }}"
    data-staff-token="{{ csrf_token('platform_staff_management') }}"
    data-tenant-token="{{ csrf_token('platform_tenant_management') }}"
>
    <section class="admin-shell admin-shell-platform" aria-label="Centro de control de Condor">
        <aside class="sidebar">
            <div class="brand-block">
                <strong>Condor App</strong>
                <span>V {{ app_version }}</span>
            </div>
            <nav aria-label="Navegación de plataforma">
                <a href="{{ path('app_platform_owner') }}" aria-current="page">Centro de control</a>
                <a href="{{ path('app_platform_diagnostics') }}">Diagnósticos</a>
            </nav>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="button button-secondary" type="submit">Cerrar sesión</button>
            </form>
        </aside>

        <div class="workspace">
            <span class="eyebrow">Propietario de plataforma</span>
            <h1>Preparando centro de control…</h1>
            <p class="muted">Cargando estado real de Condor.</p>
        </div>
    </section>
</div>
<script type="module" src="/build/admin.js"></script>
{% endblock %}
