{
  "name": "condor-app",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "vite build",
    "typecheck": "tsc --noEmit",
    "test:contract": "python3 -m unittest discover -s tests/contract -p 'test_*.py'",
    "test:integration": "python3 -m unittest discover -s tests/integration -p 'test_*.py'",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test": "npm run typecheck && npm run test:contract && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
